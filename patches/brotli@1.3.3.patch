diff --git a/dec/dictionary-browser.js b/dec/dictionary-browser.js
index 9608543881c9ffadb35c5cc00d097626159afb89..90371018040bf8c8b4f91b0220a32577b1a08f1a 100644
--- a/dec/dictionary-browser.js
