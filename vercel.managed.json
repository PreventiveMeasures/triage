{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "env": { "NODEJS_HELPERS": "0" },
  "buildCommand": "pnpm build",
  "outputDirectory": "out",
  "functions": {
    "api/managed.ts": { "maxDuration": 300, "includeFiles": "out/**" }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/api/managed" }
  ],
  "crons": [
    { "path": "/api/reap", "schedule": "0 0 * * *" }
  ]
}
